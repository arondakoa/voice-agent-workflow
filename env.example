# LiveKit — später, wenn der Clerk telefonieren soll
# https://cloud.livekit.io/
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent: insurance (Demo) oder voltwerk (CR404 Clerk, Deutsch)
AGENT_MODE=voltwerk

# LLM. Später: xAI (OpenAI-kompatibel) bevorzugen.
# OPENAI_API_KEY=
# XAI_API_KEY=   # nicht hier committen; Plattform oder Secret Store

# Render Workflows — optional, Insurance-Demo
RENDER_API_KEY=
WORKFLOW_SERVICE_ID=
